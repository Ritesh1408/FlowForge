# Copy to .env and replace the placeholders. Never commit .env.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/flowforge
# Used only by integration tests. Must point at a database named exactly flowforge_test.
TEST_DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/flowforge_test
REDIS_URL=redis://localhost:6379/0

# Optional (defaults shown)
# APP_ENV=development
# LOG_LEVEL=INFO
# HEALTH_CHECK_TIMEOUT_SECONDS=2.0
